# Terraform Backend Configuration
# Generated by InfraFoundry
# Backend Type: {{ backend_type }}
{% if supports_locking %}# State Locking: Enabled
{% else %}# State Locking: Not Supported
{% endif %}

terraform {
  backend "{{ backend_type }}" {
{% if backend_type == "s3" %}
    bucket         = "{{ backend_config.bucket }}"
    key            = "{{ backend_config.key }}"
    region         = "{{ backend_config.region }}"
    encrypt        = {{ backend_config.encrypt | lower }}
{% if backend_config.dynamodb_table %}
    dynamodb_table = "{{ backend_config.dynamodb_table }}"
{% endif %}
{% if backend_config.profile %}
    profile        = "{{ backend_config.profile }}"
{% endif %}
{% if backend_config.role_arn %}
    role_arn       = "{{ backend_config.role_arn }}"
{% endif %}
{% if backend_config.kms_key_id %}
    kms_key_id     = "{{ backend_config.kms_key_id }}"
{% endif %}

{% elif backend_type == "gcs" %}
    bucket      = "{{ backend_config.bucket }}"
    prefix      = "{{ backend_config.prefix }}"
{% if backend_config.credentials %}
    credentials = "{{ backend_config.credentials }}"
{% endif %}
{% if backend_config.encryption_key %}
    encryption_key = "{{ backend_config.encryption_key }}"
{% endif %}

{% elif backend_type == "azurerm" %}
    resource_group_name  = "{{ backend_config.resource_group_name }}"
    storage_account_name = "{{ backend_config.storage_account_name }}"
    container_name       = "{{ backend_config.container_name }}"
    key                  = "{{ backend_config.key }}"
{% if backend_config.access_key %}
    access_key           = "{{ backend_config.access_key }}"
{% endif %}
{% if backend_config.sas_token %}
    sas_token            = "{{ backend_config.sas_token }}"
{% endif %}
{% if backend_config.use_azuread_auth %}
    use_azuread_auth     = {{ backend_config.use_azuread_auth | lower }}
{% endif %}

{% elif backend_type == "postgres" %}
    conn_str             = "{{ backend_config.conn_str }}"
    schema_name          = "{{ backend_config.schema_name }}"
{% if backend_config.skip_schema_creation %}
    skip_schema_creation = {{ backend_config.skip_schema_creation | lower }}
{% endif %}

{% elif backend_type == "remote" %}
    organization = "{{ backend_config.organization }}"
{% if backend_config.hostname %}
    hostname     = "{{ backend_config.hostname }}"
{% endif %}
{% if backend_config.token %}
    token        = "{{ backend_config.token }}"
{% endif %}

    workspaces {
{% if backend_config.workspaces.name %}
      name   = "{{ backend_config.workspaces.name }}"
{% elif backend_config.workspaces.prefix %}
      prefix = "{{ backend_config.workspaces.prefix }}"
{% endif %}
    }
{% endif %}
  }
}
