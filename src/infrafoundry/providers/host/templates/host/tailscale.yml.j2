---
# Generated by InfraFoundry. Enrolls existing hosts in Tailscale.
# The auth secret is read from the INFRAFOUNDRY_TAILSCALE_AUTH_KEY environment
# variable of this run only; it is never written to inventory or controller disk.
{% raw %}
- name: Enroll hosts in Tailscale
  hosts: all
  become: true
  gather_facts: false
  vars:
    ts: "{{ infrafoundry_tailscale }}"
  tasks:
    - name: Look for the tailscale binary
      ansible.builtin.command: which tailscale
      register: ts_which
      changed_when: false
      failed_when: false

    - name: Install Tailscale when missing
      ansible.builtin.shell: |
        set -o pipefail
        curl -fsSL https://tailscale.com/install.sh | sh
      args:
        executable: /bin/bash
      when: ts_which.rc != 0
      changed_when: true

    - name: Read the Tailscale state
      ansible.builtin.command: tailscale status --json
      register: ts_status
      changed_when: false
      failed_when: false

    - name: Work out whether the host is enrolled
      ansible.builtin.set_fact:
        ts_running: "{{ ts_status.rc == 0 and ts_status.stdout | length > 0 and (ts_status.stdout | from_json).BackendState | default('') == 'Running' }}"

    - name: Enroll the host
      when: not ts_running
      block:
        - name: Create a private file for the auth secret
          ansible.builtin.tempfile:
            state: file
            prefix: infrafoundry-ts-
          register: ts_keyfile

        - name: Write the auth secret
          ansible.builtin.copy:
            dest: "{{ ts_keyfile.path }}"
            content: "{{ lookup('ansible.builtin.env', 'INFRAFOUNDRY_TAILSCALE_AUTH_KEY') }}{{ '?ephemeral=false&preauthorized=true' if ts.auth_mode == 'oauth' else '' }}"
            mode: "0600"
          no_log: true

        - name: Build the tailscale up arguments
          ansible.builtin.set_fact:
            ts_up_args: >-
              {{ ['tailscale', 'up',
                  '--auth-key=file:' ~ ts_keyfile.path,
                  '--hostname=' ~ ts.hostname,
                  '--ssh=' ~ (ts.enable_ssh | string | lower),
                  '--accept-dns=' ~ (ts.accept_dns | string | lower),
                  '--accept-routes=' ~ (ts.accept_routes | string | lower)]
                 + (['--advertise-tags=' ~ (ts.advertise_tags | join(','))] if ts.advertise_tags else [])
                 + (['--advertise-routes=' ~ (ts.advertise_routes | join(','))] if ts.advertise_routes else []) }}

        - name: Bring Tailscale up
          ansible.builtin.command:
            argv: "{{ ts_up_args }}"
          no_log: true
          changed_when: true
      always:
        - name: Remove the auth secret file
          ansible.builtin.file:
            path: "{{ ts_keyfile.path }}"
            state: absent
          when: ts_keyfile is defined and ts_keyfile.path is defined
{% endraw %}
