# Outputs for OCI resources

{% if resources_by_type.get('compartment') %}
output "compartment_ids" {
  description = "OCIDs of created compartments"
  value = {
    {% for compartment in resources_by_type['compartment'] %}
    "{{ compartment.name }}" = oci_identity_compartment.{{ compartment.name | to_terraform_name }}.id
    {% endfor %}
  }
}
{% endif %}

{% if resources_by_type.get('vcn') %}
output "vcn_ids" {
  description = "OCIDs of created VCNs"
  value = {
    {% for vcn in resources_by_type['vcn'] %}
    "{{ vcn.name }}" = oci_core_vcn.{{ vcn.name | to_terraform_name }}.id
    {% endfor %}
  }
}
{% endif %}

{% if resources_by_type.get('subnet') %}
output "subnet_ids" {
  description = "OCIDs of created subnets"
  value = {
    {% for subnet in resources_by_type['subnet'] %}
    "{{ subnet.name }}" = oci_core_subnet.{{ subnet.name | to_terraform_name }}.id
    {% endfor %}
  }
}
{% endif %}

{% if resources_by_type.get('instance') %}
output "instance_ips" {
  description = "Public IPs of created instances"
  value = {
    {% for instance in resources_by_type['instance'] %}
    "{{ instance.name }}" = oci_core_instance.{{ instance.name | to_terraform_name }}.public_ip
    {% endfor %}
  }
}

output "instance_private_ips" {
  description = "Private IPs of created instances"
  value = {
    {% for instance in resources_by_type['instance'] %}
    "{{ instance.name }}" = oci_core_instance.{{ instance.name | to_terraform_name }}.private_ip
    {% endfor %}
  }
}
{% endif %}

{% if resources_by_type.get('bucket') %}
output "objectstorage_namespace" {
  description = "Object Storage namespace of the tenancy"
  value       = data.oci_objectstorage_namespace.this.namespace
}
{% endif %}

{% set secret_keys = resources_by_type.get('customer_secret_key', []) %}
{% if secret_keys %}
# The secret is also in the Terraform state; other providers read it with an
# `outputs.oci.customer_secret_key_<name>_secret` reference.
{% for r in secret_keys %}
output "customer_secret_key_{{ r.name | to_terraform_name }}_id" {
  description = "Access key ID for {{ r.name }}"
  value       = oci_identity_customer_secret_key.{{ r.name | to_terraform_name }}.id
  sensitive   = true
}

output "customer_secret_key_{{ r.name | to_terraform_name }}_secret" {
  description = "Secret key for {{ r.name }}"
  value       = oci_identity_customer_secret_key.{{ r.name | to_terraform_name }}.key
  sensitive   = true
}

{% endfor %}
{% endif %}
