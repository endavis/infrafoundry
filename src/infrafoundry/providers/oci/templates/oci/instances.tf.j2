# OCI Compute Instances

{# Tailscale cloud-init modules — one per instance with a tailscale: block. #}
{# Issue #212 phase 2: replaces the custom cloud_init_snippets path. #}
{% for instance in instances %}
{% if instance.config.get('tailscale_module_config') %}
{% set ts = instance.config.tailscale_module_config %}
module "{{ ts.module_name }}" {
  source  = "{{ ts.source }}"
  version = "{{ ts.version }}"

  hostname      = "{{ ts.hostname }}"
  enable_ssh    = {{ ts.enable_ssh | lower }}
  accept_dns    = {{ ts.accept_dns | lower }}
  accept_routes = {{ ts.accept_routes | lower }}
  base64_encode = {{ ts.base64_encode | lower }}
  track         = "{{ ts.track }}"
  {% if ts.advertise_tags %}
  advertise_tags = {{ ts.advertise_tags | tojson }}
  {% endif %}
  {% if ts.advertise_routes %}
  advertise_routes = {{ ts.advertise_routes | tojson }}
  {% endif %}

  {% if ts.auth_mode == 'auth_key' %}
  auth_key = var.{{ ts.auth_key_var }}
  {% else %}
  client_id     = var.{{ ts.oauth_client_id_var }}
  client_secret = var.{{ ts.oauth_client_secret_var }}
  {% endif %}

  {% if ts.additional_parts %}
  additional_parts = [
    {% for part in ts.additional_parts %}
    {
      {% if part.get('filename') %}filename     = "{{ part.filename }}"
      {% endif %}{% if part.get('content_type') %}content_type = "{{ part.content_type }}"
      {% endif %}content      = <<-TSEOT
{{ part.content }}
TSEOT
      {% if part.get('merge_type') %}
      merge_type   = "{{ part.merge_type }}"
      {% endif %}
    },
    {% endfor %}
  ]
  {% endif %}
}

{% endif %}
{% endfor %}
{% for instance in instances %}
resource "oci_core_instance" "{{ instance.name | to_terraform_name }}" {
  compartment_id      = var.oci_compartment_ocid
{% if instance.config.get('availability_domain') %}
  availability_domain = "{{ instance.config.availability_domain }}"
{% else %}
  availability_domain = data.oci_identity_availability_domains.ads.availability_domains[0].name
{% endif %}
  display_name        = "{{ instance.name }}"
  shape               = "{{ instance.config.shape }}"

  {% if instance.config.get('shape_config') %}
  shape_config {
    ocpus         = {{ instance.config.shape_config.ocpus }}
    memory_in_gbs = {{ instance.config.shape_config.memory_in_gbs }}
  }
  {% endif %}

  create_vnic_details {
    subnet_id        = oci_core_subnet.{{ instance.config.subnet | to_terraform_name }}.id
    assign_public_ip = {{ instance.config.get('assign_public_ip', true) | lower }}
    display_name     = "{{ instance.name }}-vnic"
  }

  source_details {
    source_type = "image"
    source_id   = "{{ instance.config.image }}"
    {% if instance.config.get('boot_volume_size_in_gbs') %}
    boot_volume_size_in_gbs = {{ instance.config.boot_volume_size_in_gbs }}
    {% endif %}
  }

  metadata = {
    {% if instance.config.get('ssh_authorized_keys') %}
    ssh_authorized_keys = "{{ instance.config.ssh_authorized_keys | join('\\n') }}"
    {% endif %}
    {% if instance.config.get('tailscale_module_config') %}
    user_data = module.{{ instance.config.tailscale_module_config.module_name }}.rendered
    {% elif instance.config.get('cloud_init_merged') %}
    user_data = base64encode(join("\n", ["#cloud-config", yamlencode({{ instance.config.cloud_init_merged | tojson }})]))
    {% elif instance.config.get('user_data') %}
    user_data = base64encode({{ instance.config.user_data | tojson }})
    {% endif %}
  }

  {% if instance.config.get('freeform_tags') %}
  freeform_tags = {
    {% for key, value in instance.config.freeform_tags.items() %}
    "{{ key }}" = "{{ value }}"
    {% endfor %}
  }
  {% endif %}
}

{% endfor %}

{% if instances %}
data "oci_identity_availability_domains" "ads" {
  compartment_id = var.oci_tenancy_ocid
}
{% endif %}
