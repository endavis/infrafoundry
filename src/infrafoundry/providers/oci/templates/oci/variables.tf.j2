variable "oci_tenancy_ocid" {
  description = "OCID of the tenancy"
  type        = string
}

variable "oci_user_ocid" {
  description = "OCID of the user"
  type        = string
}

variable "oci_fingerprint" {
  description = "Fingerprint of the API signing key"
  type        = string
}

variable "oci_private_key_path" {
  description = "Path to the private key for API signing"
  type        = string
}

variable "oci_region" {
  description = "OCI region"
  type        = string
}

variable "oci_compartment_ocid" {
  description = "OCID of the compartment for resources"
  type        = string
}

{# Dynamic sensitive variables from resource ``terraform_secrets`` references.
   Each entry has ``name`` (sanitized terraform variable name) and ``source``
   (the original dotted secret reference, recorded in the description for
   traceability). Values are injected at apply time via TF_VAR_* env vars by
   the framework's secrets→TF_VAR bridge; defaults stay empty so terraform
   plan does not fail when a secret is unset. #}
{% for var in terraform_secret_vars | default([]) %}
variable "{{ var.name }}" {
  description = "Injected from secret reference '{{ var.source }}' via TF_VAR_{{ var.name }}."
  type        = string
  sensitive   = true
  default     = ""
}

{% endfor %}
