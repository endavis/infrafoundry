---
# Kubernetes Ansible Playbook - Post-deployment tasks
- name: Configure Kubernetes resources
  hosts: localhost
  gather_facts: false

  tasks:
    - name: Wait for deployments to be ready
      command: >
        kubectl wait --for=condition=available --timeout=300s
        deployment/{{ item.config.name }}
        -n {{ item.config.namespace | default('default') }}
      loop: "{{ resources | selectattr('type', 'equalto', 'deployments') | list }}"
      when: resources is defined

    - name: Get deployment status
      command: >
        kubectl get deployments
        -n {{ item.config.namespace | default('default') }}
        -o wide
      loop: "{{ resources | selectattr('type', 'equalto', 'deployments') | list }}"
      when: resources is defined
      register: deployment_status

    - name: Display deployment status
      debug:
        var: deployment_status
