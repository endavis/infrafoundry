---
# Kubernetes Ansible Playbook - Post-deployment tasks
- name: Configure Kubernetes resources
  hosts: localhost
  gather_facts: false

  tasks:
{% set deployments = resources | selectattr('type', 'equalto', 'deployments') | list %}
{% if deployments %}
    - name: Wait for deployments to be ready
      command: >
        kubectl wait --for=condition=available --timeout=300s
        deployment/{% raw %}{{ item.name }}{% endraw %}
        -n {% raw %}{{ item.config.namespace | default('default') }}{% endraw %}
      loop:
{% for dep in deployments %}
        - name: "{{ dep.name }}"
          config:
            namespace: "{{ dep.config.namespace | default('default') }}"
{% endfor %}
      loop_control:
        label: "{% raw %}{{ item.name }}{% endraw %}"

    - name: Get deployment status
      command: >
        kubectl get deployments
        -n {% raw %}{{ item.config.namespace | default('default') }}{% endraw %}
        -o wide
      loop:
{% for dep in deployments %}
        - name: "{{ dep.name }}"
          config:
            namespace: "{{ dep.config.namespace | default('default') }}"
{% endfor %}
      loop_control:
        label: "{% raw %}{{ item.name }}{% endraw %}"
      register: deployment_status
{% endif %}

{% if deployments %}
    - name: Display deployment status
      debug:
        var: deployment_status
{% endif %}
