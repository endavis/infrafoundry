{% for deployment in deployments %}
resource "kubernetes_deployment" "{{ deployment.config.name | replace('-', '_') }}" {
  metadata {
    name      = "{{ deployment.config.name }}"
    namespace = "{{ deployment.config.namespace | default('default') }}"

    {% if deployment.config.labels is defined %}
    labels = {
      {% for key, value in deployment.config.labels.items() %}
      "{{ key }}" = "{{ value }}"
      {% endfor %}
    }
    {% endif %}
  }

  spec {
    replicas = {{ deployment.config.replicas | default(1) }}

    selector {
      match_labels = {
        app = "{{ deployment.config.name }}"
      }
    }
    {% if deployment.config.strategy is defined %}
    strategy {
      type = "{{ deployment.config.strategy.type }}"
    }
    {% endif %}

    template {
      metadata {
        labels = {
          app = "{{ deployment.config.name }}"
          {% if deployment.config.labels is defined %}
          {% for key, value in deployment.config.labels.items() %}
          "{{ key }}" = "{{ value }}"
          {% endfor %}
          {% endif %}
        }
      }

      spec {
        {% for container in deployment.config.containers %}
        container {
          name  = "{{ container.name }}"
          image = "{{ container.image }}"
          {% if container.command is defined %}
          command = [{% for c in container.command %}"{{ c }}"{% if not loop.last %}, {% endif %}{% endfor %}]
          {% endif %}
          {% if container.args is defined %}
          args = [{% for a in container.args %}"{{ a }}"{% if not loop.last %}, {% endif %}{% endfor %}]
          {% endif %}

          {% if container.ports is defined %}
          {% for port in container.ports %}
          port {
            container_port = {{ port.containerPort }}
            {% if port.name is defined %}
            name = "{{ port.name }}"
            {% endif %}
            {% if port.protocol is defined %}
            protocol = "{{ port.protocol }}"
            {% endif %}
          }
          {% endfor %}
          {% endif %}

          {% if container.env is defined %}
          {% for env in container.env %}
          env {
            name  = "{{ env.name }}"
            {% if env.value is defined %}
            value = "{{ env.value }}"
            {% endif %}
            {% if env.value_from is defined %}
            value_from {
              {% if env.value_from.secret_key_ref is defined %}
              secret_key_ref {
                name = "{{ env.value_from.secret_key_ref.name }}"
                key  = "{{ env.value_from.secret_key_ref.key }}"
              }
              {% endif %}
              {% if env.value_from.config_map_key_ref is defined %}
              config_map_key_ref {
                name = "{{ env.value_from.config_map_key_ref.name }}"
                key  = "{{ env.value_from.config_map_key_ref.key }}"
              }
              {% endif %}
            }
            {% endif %}
          }
          {% endfor %}
          {% endif %}

          {% if container.resources is defined %}
          resources {
            {% if container.resources.limits is defined %}
            limits = {
              {% for key, value in container.resources.limits.items() %}
              "{{ key }}" = "{{ value }}"
              {% endfor %}
            }
            {% endif %}
            {% if container.resources.requests is defined %}
            requests = {
              {% for key, value in container.resources.requests.items() %}
              "{{ key }}" = "{{ value }}"
              {% endfor %}
            }
            {% endif %}
          }
          {% endif %}
          {% if container.volume_mounts is defined %}
          {% for vm in container.volume_mounts %}
          volume_mount {
            name       = "{{ vm.name }}"
            mount_path = "{{ vm.mount_path }}"
            {% if vm.sub_path is defined %}
            sub_path = "{{ vm.sub_path }}"
            {% endif %}
            {% if vm.read_only is defined %}
            read_only = {{ vm.read_only | lower }}
            {% endif %}
          }
          {% endfor %}
          {% endif %}
        }
        {% endfor %}
        {% if deployment.config.volumes is defined %}
        {% for volume in deployment.config.volumes %}
        volume {
          name = "{{ volume.name }}"
          {% if volume.config_map is defined %}
          config_map {
            name = "{{ volume.config_map.name }}"
            {% if 'items' in volume.config_map %}
            {% for item in volume.config_map['items'] %}
            items {
              key  = "{{ item.key }}"
              path = "{{ item.path }}"
            }
            {% endfor %}
            {% endif %}
          }
          {% endif %}
          {% if volume.secret is defined %}
          secret {
            secret_name = "{{ volume.secret.secret_name }}"
          }
          {% endif %}
          {% if volume.persistent_volume_claim is defined %}
          persistent_volume_claim {
            claim_name = "{{ volume.persistent_volume_claim.claim_name }}"
          }
          {% endif %}
          {% if volume.empty_dir is defined %}
          empty_dir {}
          {% endif %}
        }
        {% endfor %}
        {% endif %}
      }
    }
  }

  {% if dependency_refs or deployment.config.depends_on is defined %}
  depends_on = [
    {% for ref in dependency_refs %}
    {{ ref }},
    {% endfor %}
    {% if deployment.config.depends_on is defined %}
    {% for dep in deployment.config.depends_on %}
    {{ dep }},
    {% endfor %}
    {% endif %}
  ]
  {% endif %}
}

{% endfor %}
