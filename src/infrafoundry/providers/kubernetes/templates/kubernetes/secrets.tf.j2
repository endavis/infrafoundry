{% for secret in secrets %}
resource "kubernetes_secret" "{{ secret.name | replace('-', '_') }}" {
  metadata {
    name      = "{{ secret.name }}"
    namespace = "{{ secret.config.namespace | default('default') }}"

    {% if secret.config.labels is defined %}
    labels = {
      {% for key, value in secret.config.labels.items() %}
      "{{ key }}" = "{{ value }}"
      {% endfor %}
    }
    {% endif %}

    {% if secret.config.annotations is defined %}
    annotations = {
      {% for key, value in secret.config.annotations.items() %}
      "{{ key }}" = "{{ value }}"
      {% endfor %}
    }
    {% endif %}
  }

  type = "{{ secret.config.type | default('Opaque') }}"

  {% set sd = secret.config.string_data | default({}) %}
  {% if secret.config.data is defined %}
  binary_data = {
    {% for key, value in secret.config.data.items() %}
    {% if key not in sd %}
    "{{ key }}" = "{{ value }}"
    {% endif %}
    {% endfor %}
  }
  {% endif %}

  {% if secret.config.string_data is defined %}
  data = {
    {% for key, value in sd.items() %}
    "{{ key }}" = "{{ value }}"
    {% endfor %}
  }
  {% endif %}

  {% if dependency_refs or secret.config.depends_on is defined %}
  depends_on = [
    {% for ref in dependency_refs %}
    {{ ref }},
    {% endfor %}
    {% if secret.config.depends_on is defined %}
    {% for dep in secret.config.depends_on %}
    {{ dep }},
    {% endfor %}
    {% endif %}
  ]
  {% endif %}
}

{% endfor %}
