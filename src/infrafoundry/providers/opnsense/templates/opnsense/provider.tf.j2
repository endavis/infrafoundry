terraform {
  required_providers {
    opnsense = {
      source  = "browningluke/opnsense"
      version = "~> 0.15.0"  # Using 0.15.0 to avoid v0.16.0 tftp_server typo bug
    }
  }
}

provider "opnsense" {
  # Credentials should be provided via environment variables:
  # - OPNSENSE_URI (or uri in config)
  # - OPNSENSE_API_KEY (or api_key in config)
  # - OPNSENSE_API_SECRET (or api_secret in config)
  # - OPNSENSE_ALLOW_UNVERIFIED (optional, for self-signed certs)

  # These can also be set via tfvars:
  uri        = var.opnsense_api_url
  api_key    = var.opnsense_api_key
  api_secret = var.opnsense_api_secret
}
