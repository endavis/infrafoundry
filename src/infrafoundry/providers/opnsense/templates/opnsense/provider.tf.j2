terraform {
  required_providers {
    opnsense = {
      source  = "browningluke/opnsense"
      version = "~> 0.16"
    }
  }
}

provider "opnsense" {
  # Credentials should be provided via environment variables:
  # - OPNSENSE_API_URL
  # - OPNSENSE_API_KEY
  # - OPNSENSE_API_SECRET
  # These are loaded by the credential loader and set in the environment
}
