terraform {
  required_providers {
    opnsense = {
      source  = "browningluke/opnsense"
      version = "~> 0.16"
    }
  }
}

provider "opnsense" {
  # Credentials can be provided via:
  # 1. Terraform variables (from terraform.tfvars)
  # 2. Environment variables (OPNSENSE_API_URL, OPNSENSE_API_KEY, OPNSENSE_API_SECRET)

  # Variables are defined in variables.tf and populated from settings.yaml
  api_url    = var.opnsense_api_url
  api_key    = var.opnsense_api_key
  api_secret = var.opnsense_api_secret
}
