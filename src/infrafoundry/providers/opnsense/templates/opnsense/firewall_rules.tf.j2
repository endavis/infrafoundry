{% for rule in rules %}
resource "opnsense_firewall_rule" "{{ rule.config.name | replace('-', '_') }}" {
  description = "{{ rule.config.description | default(rule.config.name) }}"
  action      = "{{ rule.config.action | default('pass') }}"
  interface   = "{{ rule.config.interface }}"

  {% if rule.config.protocol is defined %}
  protocol = "{{ rule.config.protocol }}"
  {% endif %}

  {% if rule.config.source is defined %}
  source {
    {% if rule.config.source.network is defined %}
    network = "{{ rule.config.source.network }}"
    {% endif %}
    {% if rule.config.source.port is defined %}
    port = "{{ rule.config.source.port }}"
    {% endif %}
  }
  {% endif %}

  {% if rule.config.destination is defined %}
  destination {
    {% if rule.config.destination.network is defined %}
    network = "{{ rule.config.destination.network }}"
    {% endif %}
    {% if rule.config.destination.port is defined %}
    port = "{{ rule.config.destination.port }}"
    {% endif %}
  }
  {% endif %}

  enabled = {{ rule.config.enabled | default(true) | lower }}

  {% if rule.config.log is defined %}
  log = {{ rule.config.log | lower }}
  {% endif %}
}

{% endfor %}
