# AWS EC2 instances

{# Tailscale cloud-init modules, one per instance with a tailscale: block. #}
{% for instance in instances %}
{% if instance.config.get('tailscale_module_config') %}
{% set ts = instance.config.tailscale_module_config %}
module "{{ ts.module_name }}" {
  source  = "{{ ts.source }}"
  version = "{{ ts.version }}"

  hostname      = "{{ ts.hostname }}"
  enable_ssh    = {{ ts.enable_ssh | lower }}
  accept_dns    = {{ ts.accept_dns | lower }}
  accept_routes = {{ ts.accept_routes | lower }}
  base64_encode = {{ ts.base64_encode | lower }}
  track         = "{{ ts.track }}"
  {% if ts.advertise_tags %}
  advertise_tags = {{ ts.advertise_tags | tojson }}
  {% endif %}
  {% if ts.advertise_routes %}
  advertise_routes = {{ ts.advertise_routes | tojson }}
  {% endif %}

  auth_key = var.{{ ts.auth_key_var }}

  {% if ts.additional_parts %}
  additional_parts = [
    {% for part in ts.additional_parts %}
    {
      {% if part.get('filename') %}filename     = "{{ part.filename }}"
      {% endif %}{% if part.get('content_type') %}content_type = "{{ part.content_type }}"
      {% endif %}content      = <<-TSEOT
{{ part.content }}
TSEOT
      {% if part.get('merge_type') %}
      merge_type   = "{{ part.merge_type }}"
      {% endif %}
    },
    {% endfor %}
  ]
  {% endif %}
}

{% endif %}
{% endfor %}
{% for instance in instances %}
{% set n = instance.name | to_terraform_name %}
{% set c = instance.config %}
{% set ipv6_only = c.get('ipv6_only', false) %}
{% if c.get('ami_ssm_parameter') %}
data "aws_ssm_parameter" "{{ n }}_ami" {
  name = {{ c.ami_ssm_parameter | hcl_string }}
}

{% endif %}
resource "aws_instance" "{{ n }}" {
{% if c.get('ami_ssm_parameter') %}
  ami           = nonsensitive(data.aws_ssm_parameter.{{ n }}_ami.value)
{% else %}
  ami           = {{ c.ami | hcl_string }}
{% endif %}
  instance_type = {{ c.instance_type | hcl_string }}
  subnet_id     = {{ c.subnet_id | hcl_string }}
{% if c.get('availability_zone') %}
  availability_zone = {{ c.availability_zone | hcl_string }}
{% endif %}
{% if c.get('key_name') %}
  key_name      = {{ c.key_name | hcl_string }}
{% endif %}
{% if c.get('security_groups') %}
  vpc_security_group_ids = [
{% for ref in c.security_groups %}
{% if ref is string and ref.startswith('sg-') %}
    {{ ref | hcl_string }},
{% else %}
    aws_security_group.{{ ref | to_terraform_name }}.id,
{% endif %}
{% endfor %}
  ]
{% endif %}
{% if ipv6_only %}
  associate_public_ip_address = false
  ipv6_address_count          = {{ c.get('ipv6_address_count', 1) }}
{% else %}
{% if c.get('associate_public_ip_address') is not none %}
  associate_public_ip_address = {{ c.associate_public_ip_address | lower }}
{% endif %}
{% if c.get('ipv6_address_count') is not none %}
  ipv6_address_count          = {{ c.ipv6_address_count }}
{% endif %}
{% endif %}

  metadata_options {
    http_endpoint = "enabled"
    http_tokens   = "{{ 'required' if c.get('imdsv2_required', true) else 'optional' }}"
{% if ipv6_only %}
    http_protocol_ipv6 = "enabled"
{% endif %}
  }
{% if ipv6_only %}

  private_dns_name_options {
    hostname_type = "resource-name"
  }
{% endif %}

  root_block_device {
    volume_type = {{ c.get('root_volume_type', 'gp3') | hcl_string }}
    encrypted   = {{ c.get('root_volume_encrypted', true) | lower }}
{% if c.get('root_volume_size') %}
    volume_size = {{ c.root_volume_size }}
{% endif %}
{% if c.get('kms_key_id') %}
    kms_key_id  = {{ c.kms_key_id | hcl_string }}
{% endif %}
  }
{% if c.get('tailscale_module_config') %}

  user_data_base64 = module.{{ c.tailscale_module_config.module_name }}.rendered
{% elif c.get('cloud_init_merged') %}

  user_data = join("\n", ["#cloud-config", yamlencode({{ c.cloud_init_merged | hcl_json }})])
{% elif c.get('user_data') %}

  user_data = {{ c.user_data | hcl_string }}
{% endif %}
{% if c.get('user_data_replace_on_change') is not none %}
  user_data_replace_on_change = {{ c.user_data_replace_on_change | lower }}
{% endif %}

  tags = {
    Name = {{ instance.name | hcl_string }}
{% for key, value in (c.get('tags') or {}).items() %}
    {{ key | hcl_string }} = {{ value | hcl_string }}
{% endfor %}
  }
{% if c.get('ami_ssm_parameter') and not c.get('replace_on_ami_change', false) %}

  # The SSM parameter moves with each new image; keep the running instance.
  lifecycle {
    ignore_changes = [ami]
  }
{% endif %}
}

{% endfor %}
