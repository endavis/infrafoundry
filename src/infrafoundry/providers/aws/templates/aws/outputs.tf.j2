    {% for instance in resources_by_type['instance'] %}
    {{ instance.name | hcl_string }} = aws_instance.{{ instance.name | to_terraform_name }}.ipv6_addresses
    {% endfor %}
  }
}
{% endif %}

{% if resources_by_type.get('ebs_volume') %}
output "ebs_volume_ids" {
  description = "IDs of created EBS volumes"
  value = {
    {% for volume in resources_by_type['ebs_volume'] %}
