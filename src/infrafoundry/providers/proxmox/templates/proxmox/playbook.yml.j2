---
# Proxmox Ansible Playbook - Post-VM configuration
- name: Configure Proxmox VMs
  hosts: proxmox_vms
  become: true
  gather_facts: true

  roles:
    - role: common
      when: "'vms' in group_names"

  tasks:
    - name: Wait for VMs to be accessible
      wait_for_connection:
        timeout: 300

    - name: Update package cache
      apt:
        update_cache: yes
      when: ansible_os_family == "Debian"

    - name: Install QEMU guest agent
      package:
        name: qemu-guest-agent
        state: present
