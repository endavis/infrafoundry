{% for template in templates %}
# Template: {{ template.config.name }}
{% if template.config.download_image is defined %}
{% set custom = (template_customize | default({})).get(template.name) %}
{% set tf_name = template.config.name | replace('-', '_') %}
{% set import_storage = template.config.disk.storage | default('local') %}
# Download cloud image and create template using native bpg/proxmox provider resources
# Step 1: Download image to Proxmox storage via API
resource "proxmox_virtual_environment_download_file" "cloud_image_{{ template.config.name | replace('-', '_') }}" {
  content_type = "import"
  datastore_id = "{{ template.config.disk.storage | default('local') }}"
  node_name    = "{{ template.config.target_node }}"
  url          = "{{ template.config.download_image.url }}"
  file_name    = "{{ template.config.download_image.filename }}"
{% if template.config.download_image.decompression is defined %}
  decompression_algorithm = "{{ template.config.download_image.decompression }}"
{% endif %}
}

{% if custom %}
# Step 1b: Install packages into a copy of the downloaded image on the node (virt-customize).
# The download itself is never touched, so its drift detection stays quiet.
resource "terraform_data" "template_customize_{{ tf_name }}" {
  input = "{{ import_storage }}:import/{{ custom.filename }}"

  triggers_replace = {
    download_id = proxmox_virtual_environment_download_file.cloud_image_{{ tf_name }}.id
    packages    = "{{ custom.install }}"
    filename    = "{{ custom.filename }}"
    storage     = "{{ import_storage }}"
    ssh_cmd     = local.ssh_cmd
    ssh_user    = var.proxmox_ssh_user
    ssh_target  = "{{ template.config.target_node }}"
  }

  provisioner "local-exec" {
    command = <<-EOT
      ${local.ssh_cmd} ${var.proxmox_ssh_user}@{{ template.config.target_node }} bash -s <<'CUSTOMIZE'
      set -euo pipefail
      if ! command -v virt-customize >/dev/null 2>&1; then
        echo "virt-customize not found on the node; install the libguestfs-tools package" >&2
        exit 1
      fi
      SRC=$(pvesm path '{{ import_storage }}:import/{{ template.config.download_image.filename }}')
      DST=$(pvesm path '{{ import_storage }}:import/{{ custom.filename }}')
      cp "$SRC" "$DST.part"
      LIBGUESTFS_BACKEND=direct virt-customize -a "$DST.part" --install {{ custom.install }}
      mv "$DST.part" "$DST"
      CUSTOMIZE
    EOT
  }

  provisioner "local-exec" {
    when    = destroy
    command = <<-EOT
      ${self.triggers_replace.ssh_cmd} ${self.triggers_replace.ssh_user}@${self.triggers_replace.ssh_target} \
        "rm -f \"\$(pvesm path '${self.triggers_replace.storage}:import/${self.triggers_replace.filename}')\""
    EOT
  }
}

{% endif %}
# Step 2: Create template VM with imported disk
{% if template.import_id %}
import {
  to = proxmox_virtual_environment_vm.template_{{ template.config.name | replace('-', '_') }}
  id = "{{ template.import_id }}"
}

{% endif %}
resource "proxmox_virtual_environment_vm" "template_{{ template.config.name | replace('-', '_') }}" {
  name      = "{{ template.config.name }}"
  node_name = "{{ template.config.target_node }}"
  vm_id     = {{ template.config.vmid }}
  template  = true
  started   = false
  on_boot   = false

  cpu {
    cores   = {{ template.config.cores | default(2) }}
    sockets = {{ template.config.sockets | default(1) }}
{% if template.config.cpu_type is defined %}
    type    = "{{ template.config.cpu_type }}"
{% endif %}
  }

  memory {
    dedicated = {{ template.config.memory | default(2048) }}
    floating  = {{ template.config.balloon if template.config.balloon is defined else template.config.memory | default(2048) }}
  }

{% if template.config.agent is defined %}
  agent {
    enabled = {{ 'true' if template.config.agent else 'false' }}
  }
{% endif %}

{% if template.config.bios is defined %}
  bios = "{{ template.config.bios }}"
{% endif %}

{% if template.config.machine is defined %}
  machine = "{{ template.config.machine }}"
{% endif %}

  disk {
    datastore_id = "{{ template.config.disk.storage | default('local-lvm') }}"
{% if custom %}
    import_from  = terraform_data.template_customize_{{ tf_name }}.output
{% else %}
    import_from  = proxmox_virtual_environment_download_file.cloud_image_{{ template.config.name | replace('-', '_') }}.id
{% endif %}
    interface    = "scsi0"
{% if template.config.disk.size is defined %}
    size         = {{ template.config.disk.size | replace('G', '') }}
{% endif %}
  }

  scsi_hardware = "virtio-scsi-pci"

{% if template.config.efi_disk is defined %}
  efi_disk {
    datastore_id = "{{ template.config.efi_disk.storage | default(template.config.disk.storage) | default('local-lvm') }}"
    type         = "{{ template.config.efi_disk.type | default('4m') }}"
  }
{% endif %}

  network_device {
    bridge = "{{ template.config.network.bridge | default('vmbr0') }}"
{% if template.config.network.tag is defined and template.config.network.tag is not none and template.config.network.tag != '' %}
    vlan_id = {{ template.config.network.tag }}
{% endif %}
  }

{% if template.config.cloud_init is defined and template.config.cloud_init %}
  initialization {
    datastore_id = "{{ template.config.cloud_init_datastore | default(template.config.disk.storage) | default('local-lvm') }}"
    ip_config {
      ipv4 {
        address = "dhcp"
      }
    }
{% if template.config.ciuser is defined %}
    user_account {
      username = "{{ template.config.ciuser }}"
{% if template.config.sshkeys is defined %}
      keys = [
        "{{ template.config.sshkeys }}"
      ]
{% endif %}
    }
{% endif %}
  }
{% endif %}

{% if template.config.description is defined %}
  description = "{{ template.config.description }}"
{% endif %}

{% if template.config.tags is defined %}
  tags = {{ template.config.tags | tojson }}
{% endif %}

  lifecycle {
    prevent_destroy = {{ template.config.prevent_destroy | default(true) | tojson }}
{% if custom %}
    replace_triggered_by = [terraform_data.template_customize_{{ tf_name }}]
{% endif %}
  }
}

{% else %}
# Create template from clone or manual creation
{% if template.import_id %}
import {
  to = proxmox_virtual_environment_vm.template_{{ template.config.name | replace('-', '_') }}
  id = "{{ template.import_id }}"
}

{% endif %}
resource "proxmox_virtual_environment_vm" "template_{{ template.config.name | replace('-', '_') }}" {
  name      = "{{ template.config.name }}"
  node_name = "{{ template.config.target_node }}"
  {% if template.config.vmid is defined %}
  vm_id     = {{ template.config.vmid }}
  {% endif %}
  template  = true
  started   = false
  on_boot   = false

  {% if template.config.clone is defined %}
  # Clone from existing template/VM
  clone {
    vm_id = {{ template.config.clone }}
    {% if template.config.full_clone is defined %}
    full = {{ template.config.full_clone | lower }}
    {% endif %}
  }
  {% endif %}

  # CPU Configuration
  cpu {
    cores   = {{ template.config.cores | default(2) }}
    sockets = {{ template.config.sockets | default(1) }}
    {% if template.config.cpu is defined %}
    type    = "{{ template.config.cpu }}"
    {% endif %}
  }

  # Memory Configuration
  memory {
    dedicated = {{ template.config.memory | default(2048) }}
    floating  = {{ template.config.balloon if template.config.balloon is defined else template.config.memory | default(2048) }}
  }

  {% if template.config.agent is defined %}
  # Guest Agent
  agent {
    enabled = {{ 'true' if template.config.agent == 1 else 'false' }}
  }
  {% endif %}

  {% if template.config.disk is defined %}
  # Disk Configuration
  disk {
    datastore_id = "{{ template.config.disk.storage | default('local-lvm') }}"
    size         = {{ template.config.disk.size | default('32') | replace('G', '') }}
    interface    = "{{ 'scsi0' if template.config.disk.type == 'scsi' else 'virtio0' }}"
    {% if template.config.disk.file_format is defined %}
    file_format  = "{{ template.config.disk.file_format }}"
    {% endif %}
  }
  {% endif %}

  {% if template.config.network is defined %}
  # Network Configuration
  network_device {
    bridge = "{{ template.config.network.bridge | default('vmbr0') }}"
    {% if template.config.network.tag is defined and template.config.network.tag is not none and template.config.network.tag != '' %}
    vlan_id = {{ template.config.network.tag }}
    {% endif %}
  }
  {% endif %}

  {% if template.config.cloud_init is defined and template.config.cloud_init %}
  # Cloud-init Configuration
  initialization {
    datastore_id = "{{ template.config.cloud_init_datastore | default(template.config.disk.storage) | default('local-lvm') }}"

    {% if template.config.ciuser is defined %}
    user_account {
      username = "{{ template.config.ciuser }}"
      {% if template.config.sshkeys is defined %}
      keys = [
        "{{ template.config.sshkeys }}"
      ]
      {% endif %}
    }
    {% endif %}
  }
  {% endif %}

  {% if template.config.description is defined %}
  # Description
  description = "{{ template.config.description }}"
  {% endif %}

  {% if template.config.tags is defined %}
  # Tags
  tags = {{ template.config.tags | tojson }}
  {% endif %}

  {% if template.config.prevent_destroy | default(true) %}
  # Lifecycle - prevent accidental destruction of templates
  lifecycle {
    prevent_destroy = true
  }
  {% endif %}
}

{% endif %}
{% endfor %}
