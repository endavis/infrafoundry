{% for template in templates %}
# Template: {{ template.config.name }}
{% if template.config.download_image is defined %}
# Download image and create template from scratch using Proxmox API
# Step 1: Download image to Proxmox storage using Terraform provider
resource "proxmox_virtual_environment_download_file" "image_{{ template.config.name | replace('-', '_') }}" {
  node_name    = "{{ template.config.target_node }}"
  content_type = "iso"
  datastore_id = "local"
  file_name    = "{{ template.config.download_image.filename }}"
  url          = "{{ template.config.download_image.url }}"
  
  {% if template.config.download_image.checksum is defined %}
  checksum           = "{{ template.config.download_image.checksum }}"
  checksum_algorithm = "{{ template.config.download_image.checksum_algorithm | default('sha256') }}"
  {% endif %}
  
  overwrite = false
}

{% if template.config.download_image.extract is defined and template.config.download_image.extract %}
# Step 1b: Extract compressed file
# Note: Proxmox provider doesn't support automatic decompression yet
resource "null_resource" "extract_image_{{ template.config.name | replace('-', '_') }}" {
  depends_on = [proxmox_virtual_environment_download_file.image_{{ template.config.name | replace('-', '_') }}]
  
  provisioner "local-exec" {
    command = <<-EOT
      # Extract the file via SSH
      ${local.ssh_cmd} ${var.proxmox_ssh_user}@{{ template.config.target_node }} "cd /var/lib/vz/template/iso && \
        {% if template.config.download_image.filename.endswith('.xz') %}
        [ ! -f {{ template.config.download_image.filename | replace('.xz', '') }} ] && xz -d {{ template.config.download_image.filename }} || true
        {% elif template.config.download_image.filename.endswith('.gz') %}
        [ ! -f {{ template.config.download_image.filename | replace('.gz', '') }} ] && gunzip {{ template.config.download_image.filename }} || true
        {% endif %}"
    EOT
  }

  triggers = {
    file_id = proxmox_virtual_environment_download_file.image_{{ template.config.name | replace('-', '_') }}.id
  }
}
{% endif %}

# Step 2: Create VM using Proxmox API
resource "null_resource" "create_vm_{{ template.config.name | replace('-', '_') }}" {
  depends_on = [
    proxmox_virtual_environment_download_file.image_{{ template.config.name | replace('-', '_') }}
    {% if template.config.download_image.extract is defined and template.config.download_image.extract %}
    , null_resource.extract_image_{{ template.config.name | replace('-', '_') }}
    {% endif %}
  ]

  provisioner "local-exec" {
    command = <<-EOT
      # Create VM via API
      curl -k -X POST \
        -H "Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN" \
        "$PROXMOX_VE_ENDPOINT/api2/json/nodes/{{ template.config.target_node }}/qemu" \
        -d "vmid={{ template.config.vmid }}" \
        -d "name={{ template.config.name }}" \
        -d "memory={{ template.config.memory | default(2048) }}" \
        -d "cores={{ template.config.cores | default(2) }}" \
        -d "net0=virtio,bridge={{ template.config.network.bridge | default('vmbr0') }}{% if template.config.network.tag is defined %},tag={{ template.config.network.tag }}{% endif %}" \
        -d "ide2=local:cloudinit" \
        -d "boot=order=scsi0" \
        -d "agent=1"
    EOT
  }

  triggers = {
    vmid = "{{ template.config.vmid }}"
    name = "{{ template.config.name }}"
  }
}

# Step 3: Import disk and configure cloud-init
resource "null_resource" "configure_vm_{{ template.config.name | replace('-', '_') }}" {
  depends_on = [null_resource.create_vm_{{ template.config.name | replace('-', '_') }}]

  provisioner "local-exec" {
    command = <<-EOT
      # Import disk using Proxmox disk import API
      # Note: qm importdisk is a CLI wrapper - the underlying operation can be done via API
      # but it's complex and requires multiple steps. For now, we minimize SSH usage.
      {% if template.config.download_image.extract is defined and template.config.download_image.extract %}
      {% set image_file = template.config.download_image.filename | replace('.xz', '') | replace('.gz', '') %}
      {% else %}
      {% set image_file = template.config.download_image.filename %}
      {% endif %}
      
      # Import disk - this is one operation that Proxmox requires CLI for
      # The API doesn't expose a direct importdisk endpoint
      ${local.ssh_cmd} ${var.proxmox_ssh_user}@{{ template.config.target_node }} "qm importdisk {{ template.config.vmid }} /var/lib/vz/template/iso/{{ image_file }} {{ template.config.disk.storage | default('local-lvm') }}"
      
      # All subsequent operations use API only
      sleep 2
      
      # Attach disk via API
      curl -k -X PUT \
        -H "Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN" \
        "$PROXMOX_VE_ENDPOINT/api2/json/nodes/{{ template.config.target_node }}/qemu/{{ template.config.vmid }}/config" \
        -d "scsi0={{ template.config.disk.storage | default('local-lvm') }}:vm-{{ template.config.vmid }}-disk-0"
      
      {% if template.config.cloud_init is defined and template.config.cloud_init %}
      # Configure cloud-init via API
      {% if template.config.ciuser is defined %}
      curl -k -X PUT \
        -H "Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN" \
        "$PROXMOX_VE_ENDPOINT/api2/json/nodes/{{ template.config.target_node }}/qemu/{{ template.config.vmid }}/config" \
        -d "ciuser={{ template.config.ciuser }}"
      {% endif %}
      
      {% if template.config.sshkeys is defined %}
      curl -k -X PUT \
        -H "Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN" \
        "$PROXMOX_VE_ENDPOINT/api2/json/nodes/{{ template.config.target_node }}/qemu/{{ template.config.vmid }}/config" \
        --data-urlencode "sshkeys={{ template.config.sshkeys }}"
      {% endif %}
      
      curl -k -X PUT \
        -H "Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN" \
        "$PROXMOX_VE_ENDPOINT/api2/json/nodes/{{ template.config.target_node }}/qemu/{{ template.config.vmid }}/config" \
        -d "ipconfig0=ip=dhcp"
      {% endif %}
    EOT
  }

  triggers = {
    vmid = "{{ template.config.vmid }}"
  }
}

# Step 4: Convert VM to template using Proxmox API
resource "null_resource" "convert_to_template_{{ template.config.name | replace('-', '_') }}" {
  depends_on = [null_resource.configure_vm_{{ template.config.name | replace('-', '_') }}]

  provisioner "local-exec" {
    command = <<-EOT
      # Wait for VM to be fully configured
      sleep 5
      # Convert to template via API
      curl -k -X POST \
        -H "Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN" \
        "$PROXMOX_VE_ENDPOINT/api2/json/nodes/{{ template.config.target_node }}/qemu/{{ template.config.vmid }}/template"
    EOT
  }

  triggers = {
    vmid = "{{ template.config.vmid }}"
  }
}

{% else %}
# Create template from clone or manual creation
# Note: VM will be converted to template after creation using local-exec provisioner
resource "proxmox_virtual_environment_vm" "template_{{ template.config.name | replace('-', '_') }}" {
  name      = "{{ template.config.name }}"
  node_name = "{{ template.config.target_node }}"
  {% if template.config.vmid is defined %}
  vm_id     = {{ template.config.vmid }}
  {% endif %}

  {% if template.config.clone is defined %}
  # Clone from existing template/VM
  clone {
    vm_id = {{ template.config.clone }}
    {% if template.config.full_clone is defined %}
    full = {{ template.config.full_clone | lower }}
    {% endif %}
  }
  {% endif %}

  # CPU Configuration
  cpu {
    cores   = {{ template.config.cores | default(2) }}
    sockets = {{ template.config.sockets | default(1) }}
    {% if template.config.cpu is defined %}
    type    = "{{ template.config.cpu }}"
    {% endif %}
  }

  # Memory Configuration
  memory {
    dedicated = {{ template.config.memory | default(2048) }}
  }

  {% if template.config.agent is defined %}
  # Guest Agent
  agent {
    enabled = {{ 'true' if template.config.agent == 1 else 'false' }}
  }
  {% endif %}

  {% if template.config.disk is defined %}
  # Disk Configuration
  disk {
    datastore_id = "{{ template.config.disk.storage | default('local-lvm') }}"
    size         = {{ template.config.disk.size | default('32') | replace('G', '') }}
    interface    = "{{ 'scsi0' if template.config.disk.type == 'scsi' else 'virtio0' }}"
    {% if template.config.disk.file_format is defined %}
    file_format  = "{{ template.config.disk.file_format }}"
    {% endif %}
  }
  {% endif %}

  {% if template.config.network is defined %}
  # Network Configuration
  network_device {
    bridge = "{{ template.config.network.bridge | default('vmbr0') }}"
    {% if template.config.network.tag is defined %}
    vlan_id = {{ template.config.network.tag }}
    {% endif %}
  }
  {% endif %}

  # Don't start the VM (templates should not run)
  on_boot = false
  started = false

  {% if template.config.cloud_init is defined and template.config.cloud_init %}
  # Cloud-init Configuration
  initialization {
    datastore_id = "{{ template.config.cloud_init_datastore | default(template.config.disk.storage) | default('local-lvm') }}"
    
    {% if template.config.ciuser is defined %}
    user_account {
      username = "{{ template.config.ciuser }}"
      {% if template.config.sshkeys is defined %}
      keys = [
        "{{ template.config.sshkeys }}"
      ]
      {% endif %}
    }
    {% endif %}
  }
  {% endif %}

  {% if template.config.description is defined %}
  # Description
  description = "{{ template.config.description }}"
  {% endif %}

  {% if template.config.tags is defined %}
  # Tags
  tags = {{ template.config.tags | tojson }}
  {% endif %}

  {% if template.config.prevent_destroy | default(true) %}
  # Lifecycle - prevent accidental destruction of templates
  lifecycle {
    prevent_destroy = true
  }
  {% endif %}
}

# Convert VM to template using local-exec provisioner
resource "null_resource" "convert_to_template_{{ template.config.name | replace('-', '_') }}" {
  depends_on = [proxmox_virtual_environment_vm.template_{{ template.config.name | replace('-', '_') }}]

  provisioner "local-exec" {
    command = <<-EOT
      # Wait for VM to be fully created
      sleep 5
      # Convert to template via API using bpg provider auth
      curl -k -X POST \
        -H "Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN" \
        "$PROXMOX_VE_ENDPOINT/api2/json/nodes/{{ template.config.target_node }}/qemu/${proxmox_virtual_environment_vm.template_{{ template.config.name | replace('-', '_') }}.vm_id}/template"
    EOT
  }

  # Trigger on changes to the VM
  triggers = {
    vm_id = proxmox_virtual_environment_vm.template_{{ template.config.name | replace('-', '_') }}.id
  }
}

{% endif %}
{% endfor %}
