{% for template in templates %}
# Template: {{ template.config.name }}
# Note: To convert to template, run: qm template <vmid> on Proxmox host
# Or use the Proxmox UI to convert this VM to a template
resource "proxmox_vm_qemu" "template_{{ template.config.name | replace('-', '_') }}" {
  name        = "{{ template.config.name }}"
  target_node = "{{ template.config.target_node }}"

  {% if template.config.clone is defined %}
  # Clone from existing template/VM
  clone       = "{{ template.config.clone }}"
  full_clone  = {{ template.config.full_clone | default(true) | lower }}
  {% elif template.config.iso is defined %}
  # Create from ISO
  iso         = "{{ template.config.iso }}"
  {% endif %}

  {% if template.config.vmid is defined %}
  vmid = {{ template.config.vmid }}
  {% endif %}

  # CPU Configuration
  cores   = {{ template.config.cores | default(2) }}
  sockets = {{ template.config.sockets | default(1) }}
  cpu     = "{{ template.config.cpu | default('host') }}"

  # Memory Configuration
  memory  = {{ template.config.memory | default(2048) }}
  balloon = {{ template.config.balloon | default(0) }}

  {% if template.config.scsihw is defined %}
  # SCSI Controller
  scsihw = "{{ template.config.scsihw }}"
  {% endif %}

  {% if template.config.disk is defined %}
  # Disk Configuration
  disk {
    size    = "{{ template.config.disk.size | default('32G') }}"
    type    = "{{ template.config.disk.type | default('scsi') }}"
    storage = "{{ template.config.disk.storage | default('local-lvm') }}"
    {% if template.config.disk.cache is defined %}
    cache   = "{{ template.config.disk.cache }}"
    {% endif %}
    {% if template.config.disk.format is defined %}
    format  = "{{ template.config.disk.format }}"
    {% endif %}
  }
  {% endif %}

  {% if template.config.network is defined %}
  # Network Configuration
  network {
    model  = "{{ template.config.network.model | default('virtio') }}"
    bridge = "{{ template.config.network.bridge | default('vmbr0') }}"
    {% if template.config.network.tag is defined %}
    tag    = {{ template.config.network.tag }}
    {% endif %}
    {% if template.config.network.firewall is defined %}
    firewall = {{ template.config.network.firewall | lower }}
    {% endif %}
  }
  {% endif %}

  # Guest agent
  agent = {{ template.config.agent | default(1) }}

  # Don't start the VM (templates should not run)
  onboot = false
  oncreate = false

  {% if template.config.boot is defined %}
  # Boot order
  boot = "{{ template.config.boot }}"
  {% endif %}

  {% if template.config.bios is defined %}
  bios = "{{ template.config.bios }}"
  {% endif %}

  {% if template.config.machine is defined %}
  machine = "{{ template.config.machine }}"
  {% endif %}

  {% if template.config.cloud_init is defined and template.config.cloud_init %}
  # Cloud-init Configuration
  {% if template.config.cicustom is defined %}
  cicustom = "{{ template.config.cicustom }}"
  {% endif %}
  {% if template.config.ciuser is defined %}
  ciuser = "{{ template.config.ciuser }}"
  {% endif %}
  {% if template.config.sshkeys is defined %}
  sshkeys = <<-EOT
  {{ template.config.sshkeys }}
  EOT
  {% endif %}
  {% endif %}

  {% if template.config.description is defined %}
  # Description
  desc = "{{ template.config.description }}"
  {% endif %}

  {% if template.config.tags is defined %}
  # Tags
  tags = "{{ template.config.tags | join(',') }}"
  {% endif %}

  {% if template.config.prevent_destroy | default(true) %}
  # Lifecycle - prevent accidental destruction of templates
  lifecycle {
    prevent_destroy = true
  }
  {% endif %}
}

# Convert VM to template using null_resource and local-exec provisioner
resource "null_resource" "convert_to_template_{{ template.config.name | replace('-', '_') }}" {
  depends_on = [proxmox_vm_qemu.template_{{ template.config.name | replace('-', '_') }}]

  provisioner "local-exec" {
    command = <<-EOT
      # Wait for VM to be fully created
      sleep 10
      # Convert to template via API
      curl -k -X POST \
        -H "Authorization: PVEAPIToken=$PM_API_TOKEN_ID=$PM_API_TOKEN_SECRET" \
        "https://$PM_API_URL/api2/json/nodes/{{ template.config.target_node }}/qemu/${proxmox_vm_qemu.template_{{ template.config.name | replace('-', '_') }}.vmid}/template"
    EOT
  }

  # Trigger on changes to the VM
  triggers = {
    vm_id = proxmox_vm_qemu.template_{{ template.config.name | replace('-', '_') }}.id
  }
}

{% endfor %}
