# Outputs for Proxmox resources

{% if resources_by_type.get('vms') %}
output "vm_ips" {
  description = "IP addresses of created VMs"
  value = {
    {% for vm in resources_by_type['vms'] %}
    "{{ vm.config.name }}" = proxmox_vm_qemu.{{ vm.config.name | replace('-', '_') }}.default_ipv4_address
    {% endfor %}
  }
}
{% endif %}

{% if resources_by_type.get('container') %}
output "container_ids" {
  description = "IDs of created LXC containers"
  value = {
    {% for ct in resources_by_type['container'] %}
    "{{ ct.config.name }}" = proxmox_virtual_environment_container.{{ ct.config.name | replace('-', '_') }}.id
    {% endfor %}
  }
}
{% endif %}

{% if resources_by_type.get('templates') %}
output "templates" {
  description = "Created templates"
  value = [
    {% for template in resources_by_type['templates'] %}
    "{{ template.config.name }}",
    {% endfor %}
  ]
}
{% endif %}
