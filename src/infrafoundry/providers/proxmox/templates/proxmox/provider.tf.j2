terraform {
  required_providers {
    proxmox = {
      source  = "bpg/proxmox"
      version = "~> 0.86"
    }
  }
}

provider "proxmox" {
  # Credentials are read from environment variables:
  # - PROXMOX_VE_ENDPOINT
  # - PROXMOX_VE_API_TOKEN
  # - PROXMOX_VE_INSECURE (optional, defaults to false)

  # All configuration via environment variables - no explicit values needed
}
