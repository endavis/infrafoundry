terraform {
  required_providers {
    proxmox = {
      source  = "bpg/proxmox"
      version = "~> 0.86"
    }
    # Required by the Tailscale cloud-init module
    # (tailscale/tailscale/cloudinit). Declared unconditionally so consumers
    # that enable the optional ``tailscale:`` resource block don't need any
    # extra wiring. Unused when no VM declares ``tailscale:``.
    cloudinit = {
      source  = "hashicorp/cloudinit"
      version = "~> 2.0"
    }
  }
}

provider "proxmox" {
  # API credentials from secrets or environment variables
  endpoint  = var.proxmox_api_url
  api_token = var.proxmox_api_token_id != null && var.proxmox_api_token_secret != null ? "${var.proxmox_api_token_id}=${var.proxmox_api_token_secret}" : null
  insecure  = var.proxmox_tls_insecure

  # SSH connection for operations requiring host access
  # (e.g., template creation, disk import)
  ssh {
    agent = true
    username = var.proxmox_ssh_user
  }
}
