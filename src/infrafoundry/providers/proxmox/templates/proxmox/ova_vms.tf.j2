{% for vm in ova_vms %}
{% set vm_tf_name = vm.config.name | replace('-', '_') %}
{% set ssh_target = vm.config.target_node %}
{% set image_source = vm.config.disk_image_source | default('') %}
{% if image_source %}
{#- Where the raw image ends up on the PVE host: a URL is downloaded into the
    cache directory, and a .bz2 is decompressed there (#1094). -#}
{% set image_cache = vm.config.disk_image_cache_dir | default('/var/lib/vz/template/cache/infrafoundry') %}
{% set image_name = image_source.split('/') | last %}
{% set image_local = image_source if image_source.startswith('/') else image_cache ~ '/' ~ image_name %}
{% set image_raw = (image_cache ~ '/' ~ image_name[:-4]) if image_name.endswith('.bz2') else image_local %}
# Disk image VM: {{ vm.config.name }}
{% else %}
# OVA VM: {{ vm.config.name }}
{% endif %}
resource "terraform_data" "ova_vm_{{ vm_tf_name }}" {
{% if vm.name in (sdn_dependents | default([])) %}
  depends_on = [proxmox_sdn_applier.apply]
{% endif %}
  triggers_replace = {
    vmid         = "{{ vm.config.vmid }}"
{% if image_source %}
    disk_image_source = "{{ image_source }}"
    disk_image_sha256 = "{{ vm.config.disk_image_sha256 | default('') }}"
{% else %}
    ova_source   = "{{ vm.config.ova_source }}"
{% endif %}
    disk_bus     = "{{ vm.config.disk_bus | default('ide') }}"
    name         = "{{ vm.config.name }}"
    ssh_cmd      = local.ssh_cmd
    ssh_user     = var.proxmox_ssh_user
    ssh_target   = "{{ ssh_target }}"
    memory       = "{{ vm.config.memory | default(2048) }}"
    cores        = "{{ vm.config.cores | default(2) }}"
    cpu_type     = "{{ vm.config.cpu_type | default('host') }}"
    disk_storage = "{{ vm.config.disk_storage | default('local-lvm') }}"
    network      = "{{ vm.config.network | default([]) | tojson | replace('"', '\\"') }}"
    serial       = "{{ vm.config.serial | default(false) | string | lower }}"
    boot_order   = "{{ vm.config.boot_order | default([]) | tojson | replace('"', '\\"') }}"
    onboot       = "{{ vm.config.onboot | default(false) | string | lower }}"
    tags         = "{{ vm.config.tags | default([]) | tojson | replace('"', '\\"') }}"
  }

{% if image_source %}
  # Phase 1: Fetch, verify and decompress the disk image on the Proxmox host.
  # Each result is cached, so later runs reuse it.
  provisioner "local-exec" {
    command = <<-EOT
      ${local.ssh_cmd} ${var.proxmox_ssh_user}@{{ ssh_target }} bash -s <<'IMAGE'
      set -euo pipefail
      mkdir -p {{ image_cache }}
{% if not image_source.startswith('/') %}
      if [ ! -f {{ image_local }} ]; then
        curl -fsSL -o {{ image_local }}.part '{{ image_source }}'
        mv {{ image_local }}.part {{ image_local }}
      fi
{% endif %}
{% if vm.config.disk_image_sha256 is defined %}
      echo '{{ vm.config.disk_image_sha256 }}  {{ image_local }}' | sha256sum -c -
{% endif %}
{% if image_raw != image_local %}
      if [ ! -f {{ image_raw }} ]; then
        bunzip2 -kc {{ image_local }} > {{ image_raw }}.part
        mv {{ image_raw }}.part {{ image_raw }}
      fi
{% endif %}
      IMAGE
    EOT
  }
{% else %}
  # Phase 1: Extract OVA to temp directory on Proxmox host (skip if VMDKs exist)
  provisioner "local-exec" {
    command = <<-EOT
      ${local.ssh_cmd} ${var.proxmox_ssh_user}@{{ ssh_target }} \
        "mkdir -p /tmp/ova-${self.triggers_replace.name} && \
         if ! ls /tmp/ova-${self.triggers_replace.name}/*.vmdk 1>/dev/null 2>&1; then \
           tar -xf ${self.triggers_replace.ova_source} -C /tmp/ova-${self.triggers_replace.name}; \
         else \
           echo 'VMDKs already exist, skipping extraction'; \
         fi"
    EOT
  }
{% endif %}

  # Phase 2: Create VM shell via qm create
  provisioner "local-exec" {
    command = <<-EOT
      ${local.ssh_cmd} ${var.proxmox_ssh_user}@{{ ssh_target }} \
        "qm create ${self.triggers_replace.vmid} \
          --name ${self.triggers_replace.name} \
          --memory {{ vm.config.memory | default(2048) }} \
          --cores {{ vm.config.cores | default(2) }} \
          --cpu {{ vm.config.cpu_type | default('host') }} \
          --scsihw virtio-scsi-pci \
          {% if vm.config.network is defined %}
          {% for nic in vm.config.network %}
          --net{{ loop.index0 }} {{ nic.model | default('virtio') }},bridge={{ nic.bridge | default('vmbr0') }}{% if nic.tag is defined %},tag={{ nic.tag }}{% endif %}{% if nic.macaddr is defined %},macaddr={{ nic.macaddr }}{% endif %} \
          {% endfor %}
          {% endif %}
          {% if vm.config.serial | default(false) %}
          --serial0 socket \
          {% endif %}
          --description '{{ 'Disk image' if image_source else 'OVA' }} VM managed by InfraFoundry'"
    EOT
  }

{% if image_source %}
  # Phase 3: Import and attach the disk image
  provisioner "local-exec" {
    command = <<-EOT
      ${local.ssh_cmd} ${var.proxmox_ssh_user}@{{ ssh_target }} bash -s <<'IMPORT'
      set -euo pipefail
      IMPORT_OUT=$(qm disk import ${self.triggers_replace.vmid} {{ image_raw }} {{ vm.config.disk_storage | default('local-lvm') }} --format qcow2 2>&1)
      echo "$IMPORT_OUT"
      DISK_PATH=$(echo "$IMPORT_OUT" | grep 'successfully imported' | sed "s/.*'\(.*\)'.*/\1/")
      if [ -z "$DISK_PATH" ]; then
        echo "ERROR: Failed to import disk {{ image_raw }}" >&2
        exit 1
      fi
      qm set ${self.triggers_replace.vmid} --${self.triggers_replace.disk_bus}0 "$DISK_PATH"
      IMPORT
    EOT
  }
{% else %}
  # Phase 3: Import and attach disks from extracted OVA
  provisioner "local-exec" {
    command = <<-EOT
      ${local.ssh_cmd} ${var.proxmox_ssh_user}@{{ ssh_target }} "
        set -e
        cd /tmp/ova-${self.triggers_replace.name}
        DISK_INDEX=0
        for VMDK in \$(ls -1 *.vmdk 2>/dev/null | sort); do
          IMPORT_OUT=\$(qm disk import ${self.triggers_replace.vmid} \$VMDK {{ vm.config.disk_storage | default('local-lvm') }} --format qcow2 2>&1)
          echo \"\$IMPORT_OUT\"
          DISK_PATH=\$(echo \"\$IMPORT_OUT\" | grep 'successfully imported' | sed \"s/.*'\\(.*\\)'.*/\\1/\")
          if [ -z \"\$DISK_PATH\" ]; then
            echo \"ERROR: Failed to import disk \$VMDK\" >&2
            exit 1
          fi
          qm set ${self.triggers_replace.vmid} --${self.triggers_replace.disk_bus}\$${DISK_INDEX} \$DISK_PATH
          DISK_INDEX=\$((DISK_INDEX + 1))
        done
      "
    EOT
  }
{% endif %}

  # Phase 4: Configure boot order (extracted files persist for future runs)
  provisioner "local-exec" {
    command = <<-EOT
      ${local.ssh_cmd} ${var.proxmox_ssh_user}@{{ ssh_target }} "
        {% if vm.config.boot_order is defined %}
        qm set ${self.triggers_replace.vmid} --boot order={{ vm.config.boot_order | join(';') }}
        {% else %}
        qm set ${self.triggers_replace.vmid} --boot order=${self.triggers_replace.disk_bus}0
        {% endif %}
        {% if vm.config.onboot | default(false) %}
        qm set ${self.triggers_replace.vmid} --onboot 1
        {% endif %}
        {% if vm.config.tags is defined %}
        qm set ${self.triggers_replace.vmid} --tags {{ vm.config.tags | join(',') }}
        {% endif %}
      "
    EOT
  }

  # Destroy provisioner: stop and purge the VM
  provisioner "local-exec" {
    when    = destroy
    command = <<-EOT
      ${self.triggers_replace.ssh_cmd} ${self.triggers_replace.ssh_user}@${self.triggers_replace.ssh_target} \
        "qm stop ${self.triggers_replace.vmid} 2>/dev/null; \
         qm destroy ${self.triggers_replace.vmid} --purge"
    EOT
  }
}

{% endfor %}
