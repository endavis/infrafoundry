# Outputs for Tailscale resources

{% set keys = resources_by_type.get('tailnet_key', []) %}
{% if keys %}
# The key value is also in the Terraform state; read it with
# `terraform output -raw tailnet_key_<name>`.
{% for r in keys %}
output "tailnet_key_{{ r.name | to_terraform_name }}" {
  description = "Auth key value for {{ r.name }}"
  value       = tailscale_tailnet_key.{{ r.name | to_terraform_name }}.key
  sensitive   = true
}

{% endfor %}
output "tailnet_keys" {
  description = "Non-sensitive tailnet key details"
  value = {
{% for r in keys %}
    "{{ r.name }}" = {
      id         = tailscale_tailnet_key.{{ r.name | to_terraform_name }}.id
      expires_at = tailscale_tailnet_key.{{ r.name | to_terraform_name }}.expires_at
      invalid    = tailscale_tailnet_key.{{ r.name | to_terraform_name }}.invalid
    }
{% endfor %}
  }
}
{% endif %}

{% set clients = resources_by_type.get('oauth_client', []) %}
{% if clients %}
# The client secret is also in the Terraform state; other providers read it with
# an `outputs.tailscale.oauth_client_<name>_secret` reference.
{% for r in clients %}
output "oauth_client_{{ r.name | to_terraform_name }}_id" {
  description = "OAuth client ID for {{ r.name }}"
  value       = tailscale_oauth_client.{{ r.name | to_terraform_name }}.id
  sensitive   = true
}

output "oauth_client_{{ r.name | to_terraform_name }}_secret" {
  description = "OAuth client secret for {{ r.name }}"
  value       = tailscale_oauth_client.{{ r.name | to_terraform_name }}.key
  sensitive   = true
}

{% endfor %}
output "oauth_clients" {
  description = "Non-sensitive OAuth client details"
  value = {
{% for r in clients %}
    "{{ r.name }}" = {
      created_at = tailscale_oauth_client.{{ r.name | to_terraform_name }}.created_at
    }
{% endfor %}
  }
}
{% endif %}
