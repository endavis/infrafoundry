# direnv configuration for InfraFoundry
# This file contains framework defaults and is version-controlled
# For personal overrides, create .envrc.local (git-ignored)

# Set InfraFoundry defaults
# Use INFRAFOUNDRY_CONFIG_REPO to point to separate config repository
export INFRAFOUNDRY_CONFIG_REPO=${INFRAFOUNDRY_CONFIG_REPO:-example-config}
export INFRAFOUNDRY_OUTPUT_DIR=${INFRAFOUNDRY_OUTPUT_DIR:-generated}
export INFRAFOUNDRY_LOG_LEVEL=${INFRAFOUNDRY_LOG_LEVEL:-INFO}

# Note: SOPS age key is automatically set per-environment by the CLI from:
# secrets/{env}/age.key (e.g., secrets/dev/age.key, secrets/prod/age.key)
# This allows each environment to have its own encryption key

# Default Terraform backend type
export INFRAFOUNDRY_TF_BACKEND_TYPE=${INFRAFOUNDRY_TF_BACKEND_TYPE:-local}

# Add generated tools to PATH if they exist
PATH_add generated/bin

# Load user-specific settings from .envrc.local (git-ignored)
# This is where you put personal overrides and credentials
if [ -f .envrc.local ]; then
  source_env .envrc.local
fi
watch_file .envrc.local

# Python virtual environment support
# Use the .venv created by uv
source .venv/bin/activate

# Show loaded configuration
echo "🔧 InfraFoundry environment loaded"
echo "   Config: ${INFRAFOUNDRY_CONFIG_REPO}"
echo "   Output: ${INFRAFOUNDRY_OUTPUT_DIR}"

# Helpful warnings
if [ ! -f .envrc.local ]; then
  echo "💡 Tip: Create .envrc.local for personal settings (debug flags, etc.)"
fi
