<?php
/*
 * OPNsense bootstrap — run once on the box from the serial console shell.
 *
 * Sets the hostname, the root password and an API key for root, static WAN
 * and LAN addresses, and a WAN rule letting api_allow_cidr reach the web
 * GUI/API (plus a second rule for the LAN address when api_allow_lan is set). Turns off the image's dnsmasq DHCP on LAN. Values arrive as base64 JSON so no quoting can break the script.
 * Prints "BOOTSTRAP OK" on success; the expect script waits for it.
 */
require_once('script/load_phalcon.php');

use OPNsense\Core\Config;

$v = json_decode(base64_decode('{{ opnsense_bootstrap_values | to_json | b64encode }}'), true);

$cfg = Config::getInstance()->object();
$cfg->system->hostname = $v['hostname'];
$cfg->system->domain = $v['domain'];

$root = null;
foreach ($cfg->system->user as $user) {
    if ((string)$user->name === 'root') {
        $root = $user;
    }
}
if ($root === null) {
    echo "BOOTSTRAP FAILED: no root user\n";
    exit(1);
}
$root->password = password_hash($v['root_password'], PASSWORD_BCRYPT, ['cost' => 11]);
// 26.1 stores API keys as "<key>|<sha512-crypt of the secret>", one per line.
$root->apikeys = $v['api_key'] . '|' . crypt($v['api_secret'], '$6$$');

$wan = $cfg->interfaces->wan;
$wan->ipaddr = $v['wan_ip'];
$wan->subnet = $v['wan_prefix'];
// The WAN sits on a private network, so its default RFC1918 and bogon
// blocks would drop the controller's traffic.
unset($wan->blockpriv);
unset($wan->blockbogons);

$lan = $cfg->interfaces->lan;
$lan->ipaddr = $v['lan_ip'];
$lan->subnet = $v['lan_prefix'];

// The image ships dnsmasq serving DHCP on LAN. Turn it off and drop its
// ranges so Kea, which the OPNsense provider manages, can serve the LAN.
if (isset($cfg->dnsmasq)) {
    $cfg->dnsmasq->enable = '0';
    while (isset($cfg->dnsmasq->dhcp_ranges[0])) {
        unset($cfg->dnsmasq->dhcp_ranges[0]);
    }
}

$rule = $cfg->filter->addChild('rule');
$rule->addChild('type', 'pass');
$rule->addChild('interface', 'wan');
$rule->addChild('ipprotocol', 'inet');
$rule->addChild('protocol', 'tcp');
$rule->addChild('descr', 'infrafoundry bootstrap: web GUI/API from ' . $v['api_allow_cidr']);
$rule->addChild('source')->addChild('address', $v['api_allow_cidr']);
$destination = $rule->addChild('destination');
$destination->addChild('network', 'wanip');
$destination->addChild('port', '443');
{% if opnsense_bootstrap_values.api_allow_lan == '1' %}

// A controller outside the firewall that uses the LAN address as api_url still
// arrives through the WAN interface, so pass 443 to the LAN address there too.
$lan_rule = $cfg->filter->addChild('rule');
$lan_rule->addChild('type', 'pass');
$lan_rule->addChild('interface', 'wan');
$lan_rule->addChild('ipprotocol', 'inet');
$lan_rule->addChild('protocol', 'tcp');
$lan_rule->addChild('descr', 'infrafoundry bootstrap: web GUI/API on the LAN address from ' . $v['api_allow_cidr']);
$lan_rule->addChild('source')->addChild('address', $v['api_allow_cidr']);
$lan_destination = $lan_rule->addChild('destination');
$lan_destination->addChild('network', 'lanip');
$lan_destination->addChild('port', '443');
{% endif %}
{% if opnsense_bootstrap_sync is defined and opnsense_bootstrap_sync.ip %}

// Optional dedicated sync link: assign the third NIC as opt1 with a static
// address, so pfsync_interface: opt1 works without a manual assignment.
$s = json_decode(base64_decode('{{ opnsense_bootstrap_sync | to_json | b64encode }}'), true);
$sync = $cfg->interfaces->addChild('opt1');
$sync->addChild('if', $s['interface']);
$sync->addChild('descr', $s['descr']);
$sync->addChild('enable', '1');
$sync->addChild('ipaddr', $s['ip']);
$sync->addChild('subnet', $s['prefix']);

$pfsync_rule = $cfg->filter->addChild('rule');
$pfsync_rule->addChild('type', 'pass');
$pfsync_rule->addChild('interface', 'opt1');
$pfsync_rule->addChild('ipprotocol', 'inet');
$pfsync_rule->addChild('protocol', 'pfsync');
$pfsync_rule->addChild('descr', 'infrafoundry bootstrap: pfsync on the sync interface');
$pfsync_rule->addChild('source')->addChild('network', 'opt1');
$pfsync_rule->addChild('destination')->addChild('any');

$xmlrpc_rule = $cfg->filter->addChild('rule');
$xmlrpc_rule->addChild('type', 'pass');
$xmlrpc_rule->addChild('interface', 'opt1');
$xmlrpc_rule->addChild('ipprotocol', 'inet');
$xmlrpc_rule->addChild('protocol', 'tcp');
$xmlrpc_rule->addChild('descr', 'infrafoundry bootstrap: config sync (HTTPS) on the interface address');
$xmlrpc_rule->addChild('source')->addChild('network', 'opt1');
$xmlrpc_destination = $xmlrpc_rule->addChild('destination');
$xmlrpc_destination->addChild('network', 'opt1ip');
$xmlrpc_destination->addChild('port', '443');
{% endif %}
{% if opnsense_bootstrap_ssh is defined and opnsense_bootstrap_ssh.enabled == '1' %}

// Optional SSH daemon settings. The image ships with SSH off, so set every field
// instead of relying on what it ships.
$h = json_decode(base64_decode('{{ opnsense_bootstrap_ssh | to_json | b64encode }}'), true);
if (!isset($cfg->system->ssh)) {
    $cfg->system->addChild('ssh');
}
$ssh = $cfg->system->ssh;
if ((string)$ssh->group === '') {
    $ssh->group = 'admins';
}
$ssh->enabled = 'enabled';
if ($h['root_login'] === '1') {
    $ssh->permitrootlogin = '1';
} else {
    unset($ssh->permitrootlogin);
}
if ($h['password_auth'] === '1') {
    $ssh->passwordauth = '1';
} else {
    unset($ssh->passwordauth);
}
if (count($h['authorized_keys']) > 0) {
    $root->authorizedkeys = base64_encode(implode("\n", $h['authorized_keys']));
}
{% endif %}

Config::getInstance()->save();
echo "BOOTSTRAP OK\n";
