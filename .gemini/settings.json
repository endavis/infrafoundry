{
  "hooksConfig": {
    "enabled": true
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $GEMINI_PROJECT_DIR/tools/hooks/ai/block-dangerous-commands.py"
          }
        ]
      }
    ]
  },
  "chatCompression": {
    "contextPercentageThreshold": 0.5
  },
  "ui": {
    "autoApprove": false,
    "showToolCalls": true
  },
  "context": {
    "files": ["AGENTS.md", "GEMINI.md"]
  }
}
