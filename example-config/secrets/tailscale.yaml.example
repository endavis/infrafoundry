# Tailscale Secrets
#
# This file should be encrypted with SOPS before committing:
#   infra secrets encrypt secrets/tailscale.yaml
#

## Authentication Method 1: Auth Keys (Recommended for automation)
#
# Generate auth keys at: https://login.tailscale.com/admin/settings/keys
#
# Auth key options:
#   - Reusable: Can be used multiple times
#   - Ephemeral: Node is automatically removed when disconnected
#   - Preauthorized: Skip manual approval in admin console
#   - Tags: Assign ACL tags to nodes

# Main auth key for exit nodes
vault_tailscale_auth_key: "tskey-auth-xxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: Separate auth keys for different regions/purposes
vault_tailscale_auth_key_us: "tskey-auth-xxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
vault_tailscale_auth_key_eu: "tskey-auth-xxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
vault_tailscale_auth_key_dev: "tskey-auth-xxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
vault_tailscale_auth_key_prod: "tskey-auth-xxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

## Authentication Method 2: OAuth (For interactive deployments)
#
# Generate OAuth credentials at: https://login.tailscale.com/admin/settings/oauth
#
# OAuth is more secure but requires user interaction during deployment.
# Best for personal labs or when you want per-user authentication.

# OAuth credentials
vault_tailscale_oauth_client_id: "xxxxxxxxxxxxx"
vault_tailscale_oauth_client_secret: "tskey-client-xxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
