# Per-package secrets — SOPS-encrypted at rest.
#
# Copy this file to secrets.yaml and encrypt with SOPS:
#   cp secrets.yaml.example secrets.yaml
#   sops --encrypt --in-place secrets.yaml
#
# The same API key and secret go in the environment's opnsense provider
# settings, with api_url https://<wan_ip>.

variables:
  opnsense_root_password: "changeme123"
  opnsense_api_key: "changeme-api-key"
  opnsense_api_secret: "changeme-api-secret"
