# InfraFoundry Environment Configuration
# DEPRECATED: This file is kept for CI/CD compatibility only
#
# For local development, use .envrc.local instead!
#   1. Install direnv: https://direnv.net/
#   2. Copy: cp docs/examples/.envrc.local.example .envrc.local
#   3. Edit .envrc.local with framework settings (NOT credentials!)
#   4. Allow direnv: direnv allow
#
# ============================================================================
# CREDENTIALS ARE NOT STORED HERE!
# ============================================================================
# InfraFoundry CLI automatically loads credentials from secrets/{env}/*.yaml
# based on the --env flag. Store credentials in your config repo:
#   - secrets/dev/proxmox.yaml (encrypted with SOPS)
#   - secrets/staging/proxmox.yaml (encrypted with SOPS)
#   - secrets/prod/proxmox.yaml (encrypted with SOPS)
# See: docs/per-environment-credentials.md
# ============================================================================

# InfraFoundry framework settings
INFRAFOUNDRY_CONFIG_REPO=example-config
INFRAFOUNDRY_OUTPUT_DIR=generated
INFRAFOUNDRY_LOG_LEVEL=INFO

# SOPS encryption key path (needed to decrypt secrets/{env}/*.yaml)
SOPS_AGE_KEY_FILE=example-config/secrets/age.key

# CI/CD: Set SOPS_AGE_KEY (base64-encoded) in CI secrets
# Example: SOPS_AGE_KEY=$(cat secrets/age.key | base64 -w0)

# Terraform backend (optional - leave empty for local state)
INFRAFOUNDRY_TF_BACKEND_TYPE=local
# INFRAFOUNDRY_TF_BACKEND_TYPE=s3
# INFRAFOUNDRY_TF_BACKEND_BUCKET=my-terraform-state
# INFRAFOUNDRY_TF_BACKEND_REGION=us-east-1
# INFRAFOUNDRY_TF_BACKEND_KEY=infrafoundry/terraform.tfstate

# Ansible configuration (standard Ansible env vars)
ANSIBLE_HOST_KEY_CHECKING=False
ANSIBLE_STDOUT_CALLBACK=yaml

# Kubernetes config (if not using default ~/.kube/config)
# KUBECONFIG=/path/to/custom/kubeconfig
